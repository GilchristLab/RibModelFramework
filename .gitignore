# Eclipse Stuff
.project
*.Rhistory
*.RData

# tmp files
\#*
*~

# Build-info files generated by ./configure from their .in templates
src/include/base/AnaCoDa-config.h
inst/BUILD_INFO

# Stan model executables (compiled per-host from .stan source)
# Legacy un-tagged binaries at stan/<name> (pre-branch-tagging)
stan/roc_basic
stan/roc_sphi_est
stan/roc_mixture_sphi
stan/roc_sphi_est_centered
stan/roc_sphi_est_noncentered
stan/roc_mixture_sphi_centered
stan/roc_mixture_sphi_noncentered
# PANSE compiled model executables (per-host; never commit ELF binaries)
stan/panse_csp_only
stan/panse_csp_only_sharednse
stan/panse_basic
stan/panse_basic_sharednse
stan/panse_sphi_est_centered_sharednse
stan/panse_sphi_est_noncentered_sharednse
stan/panse_sphi_est_noncentered
stan/panse_sphi_est_sumzero_sharednse
# Branch+commit-tagged binaries at stan/build/<branch>-<sha>[-th]/<name>
stan/build/
stan/*.hpp

tmp.DECISIONS.md
# R package build artifacts (compiled per-host; never commit)
src/*.o
src/*.so
src/Makevars
# autoconf outputs (generated from configure / *.in templates)
config.log
config.status
